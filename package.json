{
  "name": "opendesk",
  "version": "0.1.0",
  "description": "OpenDesk: an Alexa+ MCP server for small-business voice booking",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "setup:dynamodb": "tsx --env-file-if-exists=.env scripts/setup-dynamodb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "chrono-node": "^2.7.7",
    "express": "^5.0.1",
    "luxon": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
