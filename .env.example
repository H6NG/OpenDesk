# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Auth: "none" (demo customer "Alex Rivera") or "oauth" (Alexa+ account linking)
AUTH_MODE=none

# OAuth (required when AUTH_MODE=oauth). Alexa+ does not support dynamic client
# registration, so the client is pre-registered via env vars.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URIS=
# Dev only: accept any redirect_uri instead of checking the allow-list above.
OAUTH_ALLOW_ANY_REDIRECT=false

# Persistence: path to a JSON file, or ":memory:" for in-memory only.
DATA_FILE=data/store.json

# Optional bearer token required to call /api/* dashboard endpoints. Ignored
# once DYNAMODB_OWNERS_TABLE/DYNAMODB_SESSIONS_TABLE below are set — real
# per-owner login takes over as the dashboard's auth at that point.
DASHBOARD_TOKEN=

# Real owner-login accounts (one owner, one business, no cross-business
# visibility), backed by DynamoDB. Optional: leave both blank and the
# dashboard behaves exactly as it does today (open, or gated by
# DASHBOARD_TOKEN above). Run `npm run setup:dynamodb` once, with your own
# AWS credentials already configured, to create these two tables.
DYNAMODB_OWNERS_TABLE=
DYNAMODB_SESSIONS_TABLE=

# Business directory, backed by DynamoDB. Optional: leave blank and the
# directory falls back to the 3 seeded demo businesses only.
DYNAMODB_BUSINESSES_TABLE=

# Amazon Bedrock (owner-side onboarding + daily briefing only, never in the hot path)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Credentials for the AWS SDK (DynamoDB, Bedrock). Only needed outside AWS
# (e.g. local dev); on ECS/Lambda/EC2 an attached IAM role is used instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Twilio SMS for reminders and order-ready notifications. Optional: if any of
# these are blank, notifications fall back to logging on the console/activity
# feed instead of failing. Even when configured, a customer is only ever
# texted after they've explicitly opted in via the set_sms_consent tool.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Freezes the clock for demos and tests, e.g. 2026-10-18T09:00:00-07:00
FRONTDESK_NOW=
